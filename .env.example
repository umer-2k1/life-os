# ─────────────────────────────────────────────────────────────────────────────
# Life OS — environment variables
# Copy to `.env.local`. Never commit real values.
# Full setup instructions: docs/13-env-keys.md
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
TIMEZONE=Asia/Karachi
CURRENCY=PKR
# The single owner's email (used for the profile row / report emails).
OWNER_EMAIL=

# ── Auth (single user) ───────────────────────────────────────────────────────
# 6-digit PIN. First run defaults to 252525 — change it in Settings.
# Random 32+ byte secret used to sign the session cookie.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
# Use the POOLED (port 6543) string in production, direct (5432) for migrations.
DATABASE_URL=
# Set to true when DATABASE_URL is the pooled Supabase connection.
DATABASE_SSL=true

# ── Image uploads (Cloudinary, recommended) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Supabase Storage (optional alternative) ──────────────────────────────────
# Without either, image uploads are disabled and you can paste image URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lifeos

# ── AI providers (free-first; can also be added later in Settings) ───────────
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Random string; must match when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Email reports (Resend, optional) ─────────────────────────────────────────
RESEND_API_KEY=
REPORT_FROM_EMAIL=Life OS <reports@yourdomain.com>

# ── Machine endpoints ────────────────────────────────────────────────────────
# Shared secret for GitHub Actions → /api/cron/*
CRON_SHARED_SECRET=
# Bearer token for the remote MCP server (/api/mcp)
MCP_AUTH_TOKEN=
